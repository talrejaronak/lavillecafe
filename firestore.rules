rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function validOrder() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name','table','type','items','total','status','createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.table is string && d.table.size() <= 20
        && d.type is string && d.type.size() <= 20
        && d.items is list && d.items.size() > 0 && d.items.size() <= 50
        && d.total is number && d.total > 0 && d.total < 100000
        && d.status == 'new'
        && d.createdAt == request.time;
    }

    // Menu: everyone can read, only admin can change
    match /menu/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: customers can only create, admin does everything else
    match /orders/{id} {
      allow create: if validOrder();
      allow read, update, delete: if isAdmin();
    }

    // Users: you can read only your own doc; created by hand in console
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
