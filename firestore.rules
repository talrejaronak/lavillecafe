rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only the cafe owner's login. Replace with the exact email you create in Firebase Authentication.
    function isOwner() {
      return request.auth != null
          && request.auth.token.email == "OWNER_EMAIL_HERE";
    }

    // What a customer is allowed to submit.
    function validNewOrder(d) {
      return d.keys().hasOnly([
               'orderId','customerName','mobile','orderType','tableNumber','items',
               'subtotal','tax','discount','grandTotal','paymentMethod','paymentStatus',
               'notes','status','createdAt'])
          && d.keys().hasAll(['orderId','customerName','mobile','orderType','tableNumber','items','grandTotal','status','createdAt'])
          && d.status == 'new'
          && d.createdAt == request.time
          && d.customerName is string && d.customerName.size() > 0 && d.customerName.size() <= 60
          && d.mobile is string && d.mobile.size() >= 10 && d.mobile.size() <= 15
          && d.orderType in ['dine-in', 'takeaway']
          && (d.tableNumber == null || (d.tableNumber is string && d.tableNumber.size() <= 10))
          && (d.orderType != 'dine-in' || (d.tableNumber is string && d.tableNumber.size() > 0))
          && d.items is list && d.items.size() > 0 && d.items.size() <= 60
          && d.grandTotal is number && d.grandTotal > 0 && d.grandTotal <= 100000
          && (!('notes' in d) || (d.notes is string && d.notes.size() <= 300));
    }

    match /orders/{orderId} {
      // Customers: create only. They can never read, change or delete orders.
      allow create: if validNewOrder(request.resource.data);

      // Owner: read everything, and change ONLY the status field.
      allow get, list: if isOwner();
      allow update: if isOwner()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['new', 'preparing', 'ready', 'done'];

      allow delete: if false;
    }
  }
}
